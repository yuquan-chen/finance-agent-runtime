# Select the execution path without changing Agent code.
# mock    = local catalog snapshot
# safe_db = allowlisted query IDs against PostgreSQL
EXECUTOR_MODE=mock

# OpenAI-compatible Chat Completions service.
# LM Studio local default; replace all three values for another provider.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-7b-instruct-mlx
LMSTUDIO_API_KEY=lm-studio

# Required for direct_db or safe_db during local integration testing.
DATABASE_URL=
SAFE_QUERY_DEFINITIONS_PATH=config/safe_queries.yaml
# Leave empty in mock mode to use the bundled demo schema.
# For a real database, set this to schema_catalog/schema.yaml after extraction.
SCHEMA_CATALOG_PATH=

# Local development identity boundary.
AUTH_MODE=local
AUTH_SECRET=

# Optional runtime limits.
DB_STATEMENT_TIMEOUT_MS=30000
DB_MAX_ROWS=1000
APP_HOST=127.0.0.1
APP_PORT=8810
