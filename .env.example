# Select the execution path without changing Agent code.
# mock    = local catalog snapshot
# safe_db = allowlisted query IDs against PostgreSQL
# query_api = DogPay backend query API (to be added after its contract is fixed)
EXECUTOR_MODE=mock

# Required only for safe_db during local integration testing.
DATABASE_URL=
SAFE_QUERY_DEFINITIONS_PATH=config/safe_queries.yaml
