# PostgreSQL 配置（Sandbox 执行 SQL 用）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=finance_sandbox
PG_USER=postgres
PG_PASSWORD=postgres

# LLM Provider 配置
# 本地 LM Studio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-7b-instruct-mlx
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_TIMEOUT_SECONDS=30

# DeepSeek API（远程，需要 API Key）
# LMSTUDIO_BASE_URL=https://api.deepseek.com
# LMSTUDIO_MODEL=deepseek-v4-flash
# LMSTUDIO_API_KEY=sk-your-api-key-here
# LMSTUDIO_TIMEOUT_SECONDS=120

# MVP must not store or use a new database credential.
# mock: execute against static local fixtures for feasibility tests.
# direct_db: disabled by default; only for a future explicitly approved adapter.
EXECUTOR_MODE=mock
DATABASE_URL=
DB_STATEMENT_TIMEOUT_MS=30000
DB_MAX_ROWS=1000

# API identity boundary
# local: development headers X-User-Id / X-Workspace-Id
# required: HMAC HS256 Bearer JWT with sub, workspace_id and exp claims
AUTH_MODE=local
AUTH_SECRET=change-me-in-production

APP_HOST=127.0.0.1
APP_PORT=8810

CATALOG_PATH=/Users/joybot/Desktop/finance-agent-runtime/config/catalog.yaml
POLICY_PATH=/Users/joybot/Desktop/finance-agent-runtime/config/policy.yaml
OPERATIONS_PATH=/Users/joybot/Desktop/finance-agent-runtime/config/operations.yaml
SKILLS_PATH=/Users/joybot/Desktop/finance-agent-runtime/config/skills.yaml
AUDIT_LOG_PATH=/Users/joybot/Desktop/finance-agent-runtime/data/audit.jsonl
PRIVATE_RESULT_STORE_PATH=/Users/joybot/Desktop/finance-agent-runtime/data/private_results.jsonl
PUBLIC_MEMORY_PATH=/Users/joybot/Desktop/finance-agent-runtime/data/public_memory.jsonl
RUN_STORE_PATH=/Users/joybot/Desktop/finance-agent-runtime/data/runs.sqlite3
KYC_DRAFT_PATH=/Users/joybot/Desktop/finance-agent-runtime/data/kyc_drafts
SESSION_STORE_PATH=/Users/joybot/Desktop/finance-agent-runtime/data/sessions
